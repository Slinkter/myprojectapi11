# ==============================================================================
# CatCloud — Variables de Entorno y Configuración de API
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto:
#   cp .env.example .env
# NUNCA subas tu archivo `.env` al repositorio de Git.

# URL base oficial de TheCatAPI v1
VITE_BASE_URL=https://api.thecatapi.com/v1/

# Clave de API de TheCatAPI (Requerida para cuota extendida, razas y favoritos)
VITE_API_KEY=tu_api_key_aqui

# ==============================================================================
# GUÍA PASO A PASO PARA OBTENER TU CLAVE GRATUITA DE THECATAPI:
# ==============================================================================
# 1. Ingresa a la página oficial de registro gratuito:
#    https://thecatapi.com/signup
#
# 2. Completa el formulario de registro:
#    - Ingresa tu correo electrónico (Email).
#    - Selecciona una descripción básica (ej: 'Personal project' o 'Portfolio').
#
# 3. Revisa tu bandeja de entrada:
#    TheCatAPI te enviará inmediatamente un correo de bienvenida con tu API Key.
#
# 4. Copia tu clave de API:
#    La clave suele comenzar con el prefijo `live_` (cadena alfanumérica).
#
# 5. Pégala en este archivo:
#    Reemplaza 'tu_api_key_aqui' con el token recibido.
#
# Con esta clave podrás acceder al catálogo completo de imágenes en alta definición,
# listado de razas felinas y almacenamiento de favoritos en la nube.
